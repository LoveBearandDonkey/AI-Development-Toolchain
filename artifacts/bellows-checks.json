[
 ["eval","({initial:document.getElementById('overhead').textContent,stroke:document.getElementById('bellows-stage').dataset.stroke})"],
 ["key","End","#bellows-stage"],
 ["wait",2000],
 ["shot","artifacts/bellows-expanded.png",".estimate-head",4],
 ["eval","(()=>{const s=document.getElementById('bellows-stage');if(s.dataset.stroke!=='100.00')throw Error('End did not fully expand');if(document.getElementById('overhead').textContent!=='≈8')throw Error('Manual changed overhead');return {stroke:s.dataset.stroke,mode:document.getElementById('bellows-follow').textContent}})()"],
 ["key","Home","#bellows-stage"],
 ["wait",2000],
 ["shot","artifacts/bellows-compressed.png",".estimate-head",4],
 ["eval","(()=>{if(document.getElementById('bellows-stage').dataset.stroke!=='0.00')throw Error('Home did not compress');return 'compressed'})()"],
 ["click","#bellows-follow"],
 ["wait",2000],
 ["eval","(()=>{const s=document.getElementById('bellows-stage');if(Math.abs(Number(s.dataset.stroke)-8/30*100)>.1)throw Error('Follow failed');document.getElementById('overhead').textContent='≈24';return 'follow restored; updating source'})()"],
 ["wait",2000],
 ["eval","(()=>{if(document.getElementById('bellows-stage').dataset.stroke!=='80.00')throw Error('Source sync failed');return 'source synced'})()"],
 ["drag","#bellows-stage",0.5,0.5,0.5,0.95,16],
 ["wait",2000],
 ["eval","(()=>{if(document.getElementById('bellows-follow').getAttribute('aria-pressed')!=='false')throw Error('Drag failed');return {dragStroke:document.getElementById('bellows-stage').dataset.stroke}})()"],
 ["key","Escape","#bellows-stage"],
 ["eval","document.getElementById('overhead').textContent='—';document.getElementById('overhead-unit').hidden=true"],
 ["wait",2000],
 ["eval","(()=>{if(document.getElementById('bellows-stage').dataset.stroke!=='0.00')throw Error('Unmodeled value failed');return document.getElementById('bellows-note').textContent})()"],
 ["lines","artifacts/bellows-lines.png","#bellows-svg"]
]
